<!DOCTYPE html>
<html>
<head>
  <base target="_top">
  <meta charset="UTF-8">
  <style>
    :root {
      --black:#28134b;
      --orange:#57228a;
      --cream:#f5f0fb;
      --white:#fff;
      --green:#247a45;
      --red:#b42318;
      --gray:#6b7280;
      --border:#dedede;
    }
    * { box-sizing:border-box; }
    body {
      margin:0;
      font-family:Arial,Helvetica,sans-serif;
      background:linear-gradient(135deg,#f8f4ff,#e8dcf5);
      color:#222;
    }
    header {
      background:#28134b;
      color:#fff;
      padding:18px 24px;
      border-bottom:6px solid var(--orange);
    }
    .header-inner {
      max-width:1200px;
      margin:auto;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:16px;
    }
    header h1 { margin:0;font-size:clamp(22px,4vw,34px); }
    header p { margin:4px 0 0;color:#ddd; }
    .nav-btn {
      background:var(--orange);
      color:#fff;
      border:0;
      border-radius:9px;
      padding:11px 16px;
      font-weight:700;
      cursor:pointer;
    }
    .page {
      max-width:1200px;
      margin:28px auto;
      padding:0 18px 40px;
    }
    .order-grid {
      display:grid;
      grid-template-columns:minmax(280px,1fr) minmax(320px,1fr);
      gap:26px;
      align-items:start;
    }
    .card {
      background:#fff;
      border-radius:16px;
      box-shadow:0 12px 30px rgba(0,0,0,.12);
      overflow:hidden;
    }
    .photo-card img {
      display:block;
      width:100%;
      height:auto;
    }
    .photo-caption {
      padding:18px 20px;
      background:#28134b;
      color:#fff;
    }
    .price {
      font-size:30px;
      font-weight:800;
      color:#e8d17a;
    }
    .form-card { padding:25px; }
    .form-card h2 { margin-top:0; }
    label {
      display:block;
      font-weight:700;
      margin:14px 0 6px;
    }
    input,select,textarea {
      width:100%;
      padding:12px;
      border:1px solid #bbb;
      border-radius:9px;
      font-size:16px;
      background:#fff;
    }
    input:focus,select:focus,textarea:focus {
      outline:3px solid rgba(87,34,138,.18);
      border-color:var(--orange);
    }
    .two-col {
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:14px;
    }
    .total-box {
      margin-top:18px;
      padding:16px;
      border-radius:10px;
      background:var(--cream);
      border-left:6px solid var(--orange);
      font-size:20px;
      font-weight:800;
    }
    .submit-btn {
      width:100%;
      margin-top:18px;
      padding:14px;
      border:0;
      border-radius:10px;
      background:var(--orange);
      color:#fff;
      font-size:18px;
      font-weight:800;
      cursor:pointer;
    }
    .submit-btn:disabled { opacity:.6;cursor:not-allowed; }
    .notice {
      display:none;
      margin-top:16px;
      padding:14px;
      border-radius:9px;
    }
    .notice.success { display:block;background:#e7f6ec;color:#14532d; }
    .notice.error { display:block;background:#feecec;color:#7f1d1d; }
    .metrics {
      display:grid;
      grid-template-columns:repeat(4,minmax(170px,1fr));
      gap:14px;
      margin-bottom:20px;
    }
    .metric {
      background:#fff;
      border-radius:13px;
      padding:18px;
      box-shadow:0 8px 20px rgba(0,0,0,.08);
      border-top:5px solid var(--orange);
    }
    .metric .label { color:var(--gray);font-size:13px;text-transform:uppercase;font-weight:700; }
    .metric .value { font-size:27px;font-weight:800;margin-top:6px; }
    .toolbar {
      display:flex;
      flex-wrap:wrap;
      gap:10px;
      align-items:center;
      margin:18px 0;
    }
    .toolbar input,.toolbar select { width:auto;min-width:190px; }
    .secondary-btn {
      border:0;
      border-radius:8px;
      padding:10px 13px;
      background:#333;
      color:#fff;
      cursor:pointer;
      font-weight:700;
    }
    .table-wrap {
      background:#fff;
      border-radius:14px;
      overflow:auto;
      box-shadow:0 8px 22px rgba(0,0,0,.08);
    }
    table { width:100%;border-collapse:collapse;min-width:1250px; }
    th {
      position:sticky;
      top:0;
      background:#28134b;
      color:#fff;
      padding:11px 9px;
      text-align:left;
      font-size:13px;
    }
    td {
      padding:10px 9px;
      border-bottom:1px solid #e6e6e6;
      vertical-align:top;
      font-size:14px;
    }
    tr:hover td { background:#faf7f2; }
    .status-select { min-width:135px;padding:8px;font-size:14px; }
    .action-btn {
      display:block;
      width:100%;
      margin:0 0 6px;
      border:0;
      border-radius:7px;
      padding:8px 9px;
      cursor:pointer;
      font-weight:700;
    }
    .pickup-btn { background:var(--orange);color:#fff; }
    .save-btn { background:#222;color:#fff; }
    .small-note { color:var(--gray);font-size:12px; }
    .loading {
      padding:30px;
      text-align:center;
      font-weight:700;
    }
    @media (max-width:850px) {
      .order-grid { grid-template-columns:1fr; }
      .metrics { grid-template-columns:repeat(2,1fr); }
      .two-col { grid-template-columns:1fr; }
      .header-inner { align-items:flex-start;flex-direction:column; }
    }
    @media (max-width:520px) {
      .metrics { grid-template-columns:1fr; }
      .form-card { padding:19px; }
    }
  </style>
</head>
<body>
<header>
  <div class="header-inner"><img src="wildcats-logo.png" alt="Wildcats logo" style="width:90px;max-height:90px;object-fit:contain">
    <div>
      <h1>Monterey Wildcats Blanket Tracker</h1>
      <p>Order your blanket today for $40 each.</p>
    </div>
    <button class="nav-btn" id="navButton" onclick="togglePage()">Dashboard</button>
  </div>
</header>

<main class="page">
  <section id="orderPage">
    <div class="order-grid">
      <div class="card photo-card">
        <img src="wildcats-blanket.jpg" alt="Monterey Wildcats blanket">
        <div class="photo-caption">
          <div class="price">$40 each</div>
          <div>Payment may be made by cash or check.</div>
        </div>
      </div>

      <div class="card form-card">
        <h2>Blanket Order Form</h2>
        <p>Complete the form below. You will receive an email confirmation and another email when your order is ready for pickup.</p>

        <form id="orderForm" onsubmit="submitOrder(event)">
          <div class="two-col">
            <div>
              <label for="firstName">First name *</label>
              <input id="firstName" name="firstName" required autocomplete="given-name">
            </div>
            <div>
              <label for="lastName">Last name *</label>
              <input id="lastName" name="lastName" required autocomplete="family-name">
            </div>
          </div>

          <label for="phone">Phone number *</label>
          <input id="phone" name="phone" type="tel" required autocomplete="tel">

          <label for="email">Email address *</label>
          <input id="email" name="email" type="email" required autocomplete="email">

          <div class="two-col">
            <div>
              <label for="quantity">Number of blankets *</label>
              <input id="quantity" name="quantity" type="number" min="1" max="25" value="1" required oninput="updateTotal()">
            </div>
            <div>
              <label for="paymentMethod">How will you be paying? *</label>
              <select id="paymentMethod" name="paymentMethod" required>
                <option value="">Choose one</option>
                <option value="Cash">Cash</option>
                <option value="Check">Check</option>
              </select>
            </div>
          </div>

          <div class="total-box">Order total: <span id="orderTotal">$40.00</span></div>
          <button class="submit-btn" id="submitButton" type="submit">Place Order</button>
          <div id="formNotice" class="notice"></div>
        </form>
      </div>
    </div>
  </section>

  <section id="dashboardPage" style="display:none;">
    <div id="dashboardLoading" class="loading card">Loading dashboard…</div>
    <div id="dashboardContent" style="display:none;">
      <div class="metrics">
        <div class="metric"><div class="label">Blankets Sold</div><div class="value" id="mSold">0</div></div>
        <div class="metric"><div class="label">Expected Revenue</div><div class="value" id="mRevenue">$0</div></div>
        <div class="metric"><div class="label">Expected Profit</div><div class="value" id="mProfit">$0</div></div>
        <div class="metric"><div class="label">Money Collected</div><div class="value" id="mCollected">$0</div></div>
        <div class="metric"><div class="label">Balance Remaining</div><div class="value" id="mBalance">$0</div></div>
        <div class="metric"><div class="label">Total Orders</div><div class="value" id="mOrders">0</div></div>
        <div class="metric"><div class="label">Blankets Picked Up</div><div class="value" id="mPickedUp">0</div></div>
        <div class="metric"><div class="label">Awaiting Pickup</div><div class="value" id="mAwaiting">0</div></div>
      </div>

      <div class="toolbar">
        <input id="searchBox" placeholder="Search name, email, phone or order…" oninput="renderOrders()">
        <select id="statusFilter" onchange="renderOrders()">
          <option value="">All order statuses</option>
          <option>Ordered</option>
          <option>Ready for Pickup</option>
          <option>Picked Up</option>
          <option>Cancelled</option>
        </select>
        <select id="paymentFilter" onchange="renderOrders()">
          <option value="">All payment statuses</option>
          <option>Pending</option>
          <option>Paid</option>
        </select>
        <button class="secondary-btn" onclick="loadDashboard()">Refresh</button>
        <button class="secondary-btn" onclick="exportCsv()">Export CSV</button>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Order</th>
              <th>Customer</th>
              <th>Contact</th>
              <th>Qty.</th>
              <th>Payment</th>
              <th>Total</th>
              <th>Profit</th>
              <th>Order Status</th>
              <th>Notes</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="ordersBody"></tbody>
        </table>
      </div>
    </div>
  </section>
</main>

<script>
  const INITIAL_PAGE = <?!= JSON.stringify(initialPage) ?>;
  let currentPage = INITIAL_PAGE;
  let dashboardData = null;
  let adminPin = sessionStorage.getItem('blanketAdminPin') || '';

  document.addEventListener('DOMContentLoaded', () => {
    updateTotal();
    if (INITIAL_PAGE === 'dashboard') {
      showPage('dashboard');
    } else {
      showPage('order');
    }
  });

  function togglePage() {
    showPage(currentPage === 'order' ? 'dashboard' : 'order');
  }

  function showPage(page) {
    currentPage = page;
    const isDashboard = page === 'dashboard';
    document.getElementById('orderPage').style.display = isDashboard ? 'none' : 'block';
    document.getElementById('dashboardPage').style.display = isDashboard ? 'block' : 'none';
    document.getElementById('navButton').textContent = isDashboard ? 'Order Form' : 'Dashboard';
    if (isDashboard) unlockDashboard();
  }

  function unlockDashboard() {
    if (!adminPin) {
      adminPin = prompt('Enter the dashboard PIN:') || '';
    }

    if (!adminPin) {
      showPage('order');
      return;
    }

    document.getElementById('dashboardLoading').style.display = 'block';
    document.getElementById('dashboardLoading').textContent = 'Checking dashboard access…';
    document.getElementById('dashboardContent').style.display = 'none';

    google.script.run
      .withSuccessHandler(() => {
        sessionStorage.setItem('blanketAdminPin', adminPin);
        loadDashboard();
      })
      .withFailureHandler(error => {
        sessionStorage.removeItem('blanketAdminPin');
        adminPin = '';
        alert(error.message || 'Dashboard access denied.');
        showPage('order');
      })
      .validateAdminPin(adminPin);
  }

  function updateTotal() {
    const qty = Math.max(1, Number(document.getElementById('quantity').value) || 1);
    document.getElementById('orderTotal').textContent = money(qty * 40);
  }

  function submitOrder(event) {
    event.preventDefault();
    const button = document.getElementById('submitButton');
    const notice = document.getElementById('formNotice');
    button.disabled = true;
    button.textContent = 'Submitting…';
    notice.className = 'notice';
    notice.textContent = '';

    const form = Object.fromEntries(new FormData(event.target).entries());

    google.script.run
      .withSuccessHandler(result => {
        notice.className = 'notice success';
        notice.innerHTML = `<strong>Order received!</strong><br>Order number: ${escapeHtml(result.orderId)}<br>Total: ${money(result.total)}`;
        event.target.reset();
        document.getElementById('quantity').value = 1;
        updateTotal();
        button.disabled = false;
        button.textContent = 'Place Order';
        window.scrollTo({ top: notice.offsetTop - 100, behavior: 'smooth' });
      })
      .withFailureHandler(error => {
        notice.className = 'notice error';
        notice.textContent = error.message || 'The order could not be submitted.';
        button.disabled = false;
        button.textContent = 'Place Order';
      })
      .submitOrder(form);
  }

  function loadDashboard() {
    document.getElementById('dashboardLoading').style.display = 'block';
    document.getElementById('dashboardLoading').textContent = 'Loading dashboard…';
    document.getElementById('dashboardContent').style.display = 'none';

    google.script.run
      .withSuccessHandler(data => {
        dashboardData = data;
        document.getElementById('dashboardLoading').style.display = 'none';
        document.getElementById('dashboardContent').style.display = 'block';
        renderMetrics();
        renderOrders();
      })
      .withFailureHandler(handleAdminFailure)
      .getDashboardData(adminPin);
  }

  function handleAdminFailure(error) {
    const message = error && error.message ? error.message : 'Unable to load dashboard.';
    if (message.toLowerCase().includes('pin')) {
      sessionStorage.removeItem('blanketAdminPin');
      adminPin = '';
    }
    document.getElementById('dashboardLoading').style.display = 'block';
    document.getElementById('dashboardLoading').textContent = message;
  }

  function renderMetrics() {
    const m = dashboardData.metrics;
    document.getElementById('mSold').textContent = m.blanketsSold;
    document.getElementById('mRevenue').textContent = money(m.expectedRevenue);
    document.getElementById('mProfit').textContent = money(m.expectedProfit);
    document.getElementById('mCollected').textContent = money(m.moneyCollected);
    document.getElementById('mBalance').textContent = money(m.balanceRemaining);
    document.getElementById('mOrders').textContent = m.totalOrders;
    document.getElementById('mPickedUp').textContent = m.blanketsPickedUp;
    document.getElementById('mAwaiting').textContent = m.blanketsRemainingForPickup;
  }

  function renderOrders() {
    if (!dashboardData) return;

    const search = document.getElementById('searchBox').value.toLowerCase().trim();
    const status = document.getElementById('statusFilter').value;
    const payment = document.getElementById('paymentFilter').value;

    const filtered = dashboardData.orders.filter(order => {
      const haystack = [order.orderId, order.firstName, order.lastName, order.email, order.phone].join(' ').toLowerCase();
      return (!search || haystack.includes(search))
        && (!status || order.orderStatus === status)
        && (!payment || order.paymentStatus === payment);
    });

    const body = document.getElementById('ordersBody');
    if (!filtered.length) {
      body.innerHTML = '<tr><td colspan="10" style="text-align:center;padding:30px;">No matching orders.</td></tr>';
      return;
    }

    body.innerHTML = filtered.map(order => `
      <tr>
        <td><strong>${escapeHtml(order.orderId)}</strong><br><span class="small-note">${escapeHtml(order.timestamp)}</span></td>
        <td><strong>${escapeHtml(order.firstName)} ${escapeHtml(order.lastName)}</strong></td>
        <td>${escapeHtml(order.phone)}<br><a href="mailto:${escapeHtml(order.email)}">${escapeHtml(order.email)}</a></td>
        <td>${order.quantity}</td>
        <td>
          <div>${escapeHtml(order.paymentMethod)}</div>
          <select class="status-select" id="pay-${order.rowNumber}">
            <option value="Pending" ${order.paymentStatus === 'Pending' ? 'selected' : ''}>Pending</option>
            <option value="Paid" ${order.paymentStatus === 'Paid' ? 'selected' : ''}>Paid</option>
          </select>
        </td>
        <td>${money(order.total)}</td>
        <td>${money(order.profit)}</td>
        <td>
          <select class="status-select" id="status-${order.rowNumber}">
            ${['Ordered','Ready for Pickup','Picked Up','Cancelled'].map(s => `<option value="${s}" ${order.orderStatus === s ? 'selected' : ''}>${s}</option>`).join('')}
          </select>
          ${order.readyEmailSent ? `<div class="small-note">Pickup email: ${escapeHtml(order.readyEmailSent)}</div>` : ''}
        </td>
        <td><textarea id="notes-${order.rowNumber}" rows="3">${escapeHtml(order.notes)}</textarea></td>
        <td>
          <button class="action-btn pickup-btn" onclick="sendPickup(${order.rowNumber})">Email Pickup Notice</button>
          <button class="action-btn save-btn" onclick="saveOrder(${order.rowNumber})">Save Changes</button>
        </td>
      </tr>
    `).join('');
  }

  function saveOrder(rowNumber) {
    const changes = {
      paymentStatus: document.getElementById(`pay-${rowNumber}`).value,
      orderStatus: document.getElementById(`status-${rowNumber}`).value,
      notes: document.getElementById(`notes-${rowNumber}`).value
    };

    google.script.run
      .withSuccessHandler(data => {
        dashboardData = data;
        renderMetrics();
        renderOrders();
      })
      .withFailureHandler(error => alert(error.message || 'Unable to save changes.'))
      .updateOrderStatus(adminPin, rowNumber, changes);
  }

  function sendPickup(rowNumber) {
    if (!confirm('Send the ready-for-pickup email now?')) return;

    google.script.run
      .withSuccessHandler(data => {
        dashboardData = data;
        renderMetrics();
        renderOrders();
        alert('Pickup email sent.');
      })
      .withFailureHandler(error => alert(error.message || 'Unable to send the email.'))
      .sendPickupEmail(adminPin, rowNumber);
  }

  function exportCsv() {
    google.script.run
      .withSuccessHandler(result => {
        const blob = new Blob(['\ufeff' + result.csv], { type: 'text/csv;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = result.fileName || 'Blanket_Orders.csv';
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      })
      .withFailureHandler(error => alert(error.message || 'Unable to export CSV.'))
      .exportOrdersCsv(adminPin);
  }

  function money(value) {
    return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(Number(value || 0));
  }

  function escapeHtml(value) {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }
</script>
</body>
</html>
